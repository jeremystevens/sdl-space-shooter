<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="space_shooter" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/space_shooter" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="/usr/include/SDL2" />
				</Compiler>
				<Linker>
					<Add library="SDL2" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/space_shooter" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add directory="include" />
		</Compiler>
		<Linker>
			<Add library="m" />
		</Linker>
		<Unit filename="include/audio.h" />
		<Unit filename="include/bullet.h" />
		<Unit filename="include/collision.h" />
		<Unit filename="include/enemy.h" />
		<Unit filename="include/player.h" />
		<Unit filename="include/starfield.h" />
		<Unit filename="main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/audio.c">
