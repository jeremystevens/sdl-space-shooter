		</Unit>
		<Unit filename="src/enemy.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/player.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/starfield.c">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions />
	</Project>
